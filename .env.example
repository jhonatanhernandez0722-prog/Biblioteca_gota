# ─────────────────────────────────────────────────────────────
# Biblioteca Gota Gota · variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# Nunca subas `.env` al repositorio: ya está en .gitignore.
# Ninguna de estas claves llega al navegador salvo las NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────

# URL pública de la aplicación (enlaces de los correos y tarjetas para compartir).
APP_URL=http://localhost:3000

# Zona horaria de la biblioteca (fechas de devolución y de recogida).
NEXT_PUBLIC_LIBRARY_TIMEZONE=America/Bogota

# Datos locales: base de datos SQLite y archivos subidos (fuera de /public).
DATABASE_PATH=./data/gotagota.db
STORAGE_DIR=./storage

# Muestra el aviso de demostración y las cuentas de prueba en «Entrar».
# Ponlo en false en cuanto cargues datos reales.
DEMO_MODE=true

# ── Metadatos de libros ──────────────────────────────────────
# openlibrary (por defecto, sin clave, datos CC0) | googlebooks (requiere clave)
BOOK_METADATA_PROVIDER=openlibrary
# Recomendado: identifica tus peticiones ante Open Library (3 consultas/s en lugar de 1).
OPENLIBRARY_CONTACT_EMAIL=
# Opcional. Solo servidor. Ojo: los términos de Google (§5e) no permiten
# crear bases de datos permanentes con su contenido.
GOOGLE_BOOKS_API_KEY=

# ── Correo (recuperación de contraseña y avisos de préstamo) ──
# console: escribe los correos en la consola del servidor (solo desarrollo)
# resend: envía con https://resend.com (necesita RESEND_API_KEY y un dominio verificado)
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM="Biblioteca Gota Gota <no-responder@tu-dominio.org>"

# ── Datos de contacto que aparecen en el pie y en /contacto ──
LIBRARY_EMAIL=
LIBRARY_PHONE=
LIBRARY_ADDRESS=
LIBRARY_HOURS=

# true solo si hay un proxy de confianza (Nginx, Vercel…) que fija X-Forwarded-For.
TRUST_PROXY=false

# ── Responsable del tratamiento (Ley 1581 de 2012) ──
# Obligatorios antes de publicar los documentos legales definitivos.
LEGAL_NAME=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
